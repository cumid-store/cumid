/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' __SCRIPT_HASHES__ https://static.cloudflareinsights.com https://www.googletagmanager.com; connect-src 'self' https://*.supabase.co https://cloudflareinsights.com https://www.google-analytics.com https://region1.google-analytics.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://wa.me;
  Strict-Transport-Security: max-age=31536000

# Cache-control for static hashed assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Cache-control for brand vector assets
/brand/*
  Cache-Control: public, max-age=86400

# Private and callback routes: never cache, never index
/account/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-cache, no-store, must-revalidate

/auth/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-cache, no-store, must-revalidate

/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-cache, no-store, must-revalidate

/admin
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store

/account
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: private, no-store

/auth/callback
  Referrer-Policy: no-referrer

/auth/callback/
  Referrer-Policy: no-referrer
