---
import BaseLayout from '../layouts/BaseLayout.astro';
import Checkout from '../components/islands/Checkout';
import '../styles/commerce.css';
---
<BaseLayout title="Checkout | CUMID" description="Review your diary order, delivery details and purchase terms." noindex={true}>
 <section class="max-w-4xl mx-auto px-5 py-12"><header class="mb-10"><p class="text-sm text-lavender-700">CUMID pocket diaries</p><h1 class="text-4xl mt-3 mb-4">Your next little diary.</h1><p>Review every detail before you pay.</p></header><Checkout client:load /></section>
</BaseLayout>
