---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StructuredData from '../../components/StructuredData.astro';
import WhatsAppPreorderButton from '../../components/islands/WhatsAppPreorderButton';
import FavouritesButton from '../../components/islands/FavouritesButton';
import ProductCheckout from '../../components/islands/ProductCheckout';
import ProductPrice from '../../components/islands/ProductPrice';
import ProductCard from '../../components/ProductCard.astro';
import DiaryMockup from '../../components/DiaryMockup.astro';
import { PRODUCTS } from '../../data/products';
import { FAQ_ITEMS } from '../../data/faq';
import { SITE } from '../../config/site';

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

const breadcrumbs = [
  { label: 'Shop', href: '/shop' },
  { label: product.collectionName, href: `/collections/${product.collection}` },
  { label: product.name },
];

const relatedProducts = [...PRODUCTS.filter(p => p.collection === product.collection && p.slug !== product.slug), ...PRODUCTS.filter(p => p.collection !== product.collection)].slice(0, 3);
const relevantFaqs = FAQ_ITEMS.filter((f) => f.category === 'preorders' || f.category === 'product').slice(0, 4);
---

<BaseLayout
  title={product.seoTitle}
  description={product.seoDescription}
  canonicalUrl={`${SITE.canonicalUrl}/products/${product.slug}`}
  ogImage={`${SITE.canonicalUrl}${product.images[0]?.src}`}
  preloadImage={product.images[0]?.src}
  schemaType="product"
  product={product}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-14 space-y-12">
    
    <Breadcrumbs items={breadcrumbs} />

    <!-- Product Main Stage (Gallery + Info) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      <!-- Left Column: Product Gallery -->
      <div class="lg:col-span-7 space-y-4">
        <!-- Main Primary View -->
        <div class="relative aspect-square w-full overflow-hidden bg-ivory-300 p-5 flex items-center justify-center">
          <DiaryMockup imageId="main-product-image" src={product.images[0].src} alt={`${product.name} top-spiral diary concept. ${product.images[0].alt}`} eager={true} />

          <!-- Floating Badges -->
          <div class="absolute top-4 left-4 flex flex-col gap-1.5">
            {product.isDesignPreview && (
              <span class="badge-preview shadow-sm text-xs">Design preview</span>
            )}
          </div>
        </div>

        <!-- Gallery Thumbnails (Flat cover and Perspective mockup) -->
        {product.images.length > 1 && (
          <div class="grid grid-cols-4 gap-3">
            {product.images.map((img, idx) => (
              <button
                type="button"
                data-gallery-src={img.src}
                data-gallery-alt={img.alt}
                class="aspect-square rounded-sm overflow-hidden bg-ivory-100 border border-charcoal-800/15 p-1.5 hover:border-lavender-600 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lavender-600 transition-all"
                aria-label={`View image ${idx + 1}`}
                title={img.alt}
              >
                <img
                  src={img.src}
                  alt={img.alt}
                  width={140}
                  height={140}
                  class="w-full h-full object-cover rounded-sm"
                  loading="lazy"
                />
              </button>
            ))}
          </div>
        )}

        {product.isDesignPreview && (
          <p class="text-xs text-charcoal-700/70 italic text-center pt-1">
            Digital diary mockup. Binding colour, materials and finished dimensions are illustrative; final details will be confirmed before ordering.
          </p>
        )}
      </div>

      <!-- Right Column: Product Detail & Preorder Actions -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Category & ID -->
        <div class="flex items-center justify-between text-xs text-charcoal-700/70 font-semibold tracking-wider uppercase">
          <a href={`/collections/${product.collection}`} class="hover:text-lavender-700 underline underline-offset-2">
            {product.collectionName} Collection
          </a>
          <span class="font-mono text-[11px]">Ref: {product.id}</span>
        </div>

        <!-- Product Name & Tagline -->
        <div class="space-y-2">
          <h1 class="text-3xl sm:text-4xl font-semibold text-charcoal-900 tracking-tight">
            {product.name}
          </h1>
          <p class="text-base text-lavender-700 font-medium">
            {product.tagline}
          </p>
        </div>

        <!-- Status & Pricing Info -->
        <div class="py-5 border-y border-charcoal-800/15 space-y-2">
          <div class="flex items-center justify-between text-sm">
            <span class="text-charcoal-700 font-medium">Availability:</span>
            <span class="text-[11px]">Check ordering options below</span>
          </div>
          <div class="flex items-center justify-between text-sm pt-1 border-t border-charcoal-800/5">
            <span class="text-charcoal-700 font-medium">Price:</span>
            <ProductPrice />
          </div>
        </div>

        <!-- Preorder Clarification Notice (Strict requirement from brief) -->
        <div class="p-4 rounded-sm bg-ivory-200 border-l border-charcoal-800/20 text-sm text-charcoal-700 leading-relaxed space-y-1">
          <p class="font-semibold text-charcoal-900">Preorder Notice:</p>
          <p>
            Review the confirmed specifications and dispatch estimate before ordering. If online checkout is unavailable, enquire about the next batch. An enquiry does not reserve stock.
          </p>
        </div>

        <!-- CTA Action Buttons (WhatsApp Preorder + Favourites) -->
        <div class="space-y-3 pt-2">
          <ProductCheckout productId={product.id} client:load />
          <WhatsAppPreorderButton
            client:load
            product={product}
            ctaPlacement="product_detail"
            showFallbackCopy={true}
          />

          <FavouritesButton
            client:load
            productId={product.id}
            productName={product.name}
            iconOnly={false}
          />
        </div>

        <!-- Confirmed Specifications Only (Strict rule: no fabricated GSM or page count) -->
        <div class="pt-6 border-t border-charcoal-800/10 space-y-3">
          <h2 class="text-xs font-semibold uppercase tracking-wider text-charcoal-700/70">
            Confirmed Format &amp; Specifications
          </h2>
          <dl class="grid grid-cols-2 gap-3 text-xs">
            <div class="py-3 border-b border-charcoal-800/10">
              <dt class="text-charcoal-700/70">Shape &amp; Size</dt>
              <dd class="font-semibold text-charcoal-900 mt-0.5">{product.confirmedSpecs.format}</dd>
            </div>
            <div class="py-3 border-b border-charcoal-800/10">
              <dt class="text-charcoal-700/70">Binding Location</dt>
              <dd class="font-semibold text-charcoal-900 mt-0.5">{product.confirmedSpecs.binding}</dd>
            </div>
            <div class="py-3 border-b border-charcoal-800/10 col-span-2">
              <dt class="text-charcoal-700/70">Writing Orientation</dt>
              <dd class="font-semibold text-charcoal-900 mt-0.5">{product.confirmedSpecs.orientation}</dd>
            </div>
          </dl>
          <p class="text-[11px] text-charcoal-700/60 italic">
            Exact paper GSM, page count, and dimensions are owner-confirmed prior to batch production and will be shared during your WhatsApp enquiry.
          </p>
        </div>

      </div>

    </div>

    <!-- Long Story & Creative Inspiration -->
    <div class="max-w-3xl pt-8 border-t border-charcoal-800/10 space-y-4">
      <h2 class="text-2xl font-bold text-charcoal-900">
        About this design
      </h2>
      <p class="text-sm sm:text-base text-charcoal-700 leading-relaxed">
        {product.longDescription}
      </p>
    </div>

    <!-- Relevant Preorder FAQs on Product Page -->
    <div class="pt-10 border-t border-charcoal-800/10 space-y-6">
      <h2 class="text-2xl font-bold text-charcoal-900">
        Questions about preordering {product.name}
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {relevantFaqs.map((faq) => (
          <div class="py-5 border-y border-charcoal-800/15 space-y-2">
            <h3 class="font-bold text-sm text-charcoal-900">{faq.question}</h3>
            <p class="text-xs text-charcoal-700 leading-relaxed">{faq.answer}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Related Designs -->
    <div class="pt-12 border-t border-charcoal-800/10 space-y-6">
      <div class="flex items-center justify-between">
        <h2 class="text-2xl font-bold text-charcoal-900">
          More covers to explore
        </h2>
        <a href="/shop" class="text-xs font-semibold text-lavender-700 hover:text-lavender-900 underline underline-offset-4">
          View all covers &rarr;
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {relatedProducts.map((rel) => (
          <ProductCard product={rel} ctaPlacement="product_gallery" />
        ))}
      </div>
    </div>

  </div>

  <StructuredData
    type="breadcrumbs"
    breadcrumbs={breadcrumbs.map((b) => ({ name: b.label, item: b.href || Astro.url.pathname }))}
  />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-gallery-src]').forEach(button => {
    button.addEventListener('click', () => {
      const image = document.querySelector<HTMLImageElement>('#main-product-image');
      if (image) {
        image.src = button.dataset.gallerySrc || '';
        image.alt = button.dataset.galleryAlt || '';
        image.closest('[data-diary-object]')?.classList.toggle('diary-photo', image.src.includes('/mockup.webp'));
      }
    });
  });
</script>
