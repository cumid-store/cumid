---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../config/site';

const breadcrumbs = [
  { label: 'How Preorders Work', href: '/how-preorders-work' },
];
---

<BaseLayout
  title="How Preorders & Enquiries Work | CUMID Stationery"
  description="Learn how CUMID small-batch preorder enquiries work via WhatsApp. No website payments, verified pricing, and direct customer communication."
  canonicalUrl={`${SITE.canonicalUrl}/how-preorders-work`}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-12">
    
    <Breadcrumbs items={breadcrumbs} />

    <header class="space-y-4">
      <span class="text-xs font-semibold tracking-wider uppercase text-lavender-700">
        Preorder Guide
      </span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-charcoal-900 tracking-tight">
        How Preorders Work at CUMID
      </h1>
      <p class="text-base sm:text-lg text-charcoal-700 leading-relaxed">
        Everything you need to know about our batch preorder enquiries, pricing confirmation, and payment safety.
      </p>
    </header>

    <!-- Key Safety Notice -->
    <div class="p-6 rounded-3xl bg-amber-50/80 border border-amber-200 text-amber-950 text-xs sm:text-sm leading-relaxed space-y-2">
      <h2 class="font-bold text-sm text-amber-900">Important Launch Notice:</h2>
      <ul class="list-disc pl-5 space-y-1">
        <li>All current candidate covers are marked <strong>Sold Out</strong> or in design preview.</li>
        <li>Sending a WhatsApp enquiry <strong>does not reserve stock</strong> or automatically create a purchase order.</li>
        <li>This website collects <strong>zero online payments</strong>. There are no credit/debit card forms or checkout gateways here.</li>
      </ul>
    </div>

    <!-- Step by Step Journey -->
    <div class="space-y-8">
      <h2 class="text-2xl font-bold text-charcoal-900">
        The 3-Step Enquiry Journey
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-3xl bg-ivory-100 border border-charcoal-800/10 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-charcoal-800 text-ivory-100 flex items-center justify-center font-bold text-sm">
            1
          </div>
          <h3 class="font-bold text-base text-charcoal-900">Explore &amp; Select</h3>
          <p class="text-xs text-charcoal-700 leading-relaxed">
            Browse our catalogue across Floral, Cute, Hinglish, and Cars &amp; Jets themes. Pick the design that fits your journaling habits.
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-ivory-100 border border-charcoal-800/10 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-lavender-700 text-ivory-100 flex items-center justify-center font-bold text-sm">
            2
          </div>
          <h3 class="font-bold text-base text-charcoal-900">Send WhatsApp Enquiry</h3>
          <p class="text-xs text-charcoal-700 leading-relaxed">
            Clicking the preorder button opens a pre-composed message with the product name and unique ID directly to our WhatsApp (+91 7023987458).
          </p>
        </div>

        <div class="p-6 rounded-3xl bg-ivory-100 border border-charcoal-800/10 space-y-3">
          <div class="w-10 h-10 rounded-xl bg-peach-700 text-ivory-100 flex items-center justify-center font-bold text-sm">
            3
          </div>
          <h3 class="font-bold text-base text-charcoal-900">Personal Confirmation</h3>
          <p class="text-xs text-charcoal-700 leading-relaxed">
            We confirm the final price, verified paper weight/dimensions, and estimated dispatch dates before you decide to proceed with an order.
          </p>
        </div>
      </div>
    </div>

    <!-- Why WhatsApp -->
    <div class="prose prose-charcoal text-charcoal-800 text-sm sm:text-base space-y-4">
      <h2 class="text-2xl font-bold text-charcoal-900">Why do we accept preorders through WhatsApp?</h2>
      <p>
        Stationery is tactile and personal. Rather than running an impersonal checkout queue with hidden terms, we prefer direct, honest conversations. When you ask about a cover, you talk directly with our team in India.
      </p>
      <p>
        You can ask any questions regarding page ruling, coil feel, or gifting options before making a commitment.
      </p>
    </div>

    <!-- CTA -->
    <div class="pt-6 border-t border-charcoal-800/10 flex flex-col sm:flex-row gap-4">
      <a href="/shop" class="btn-primary text-xs text-center">
        Explore candidate covers &rarr;
      </a>
      <a
        href={SITE.whatsappBaseUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="btn-secondary text-xs text-center"
      >
        Chat on WhatsApp ({SITE.whatsappDisplayNumber})
      </a>
    </div>

  </div>
</BaseLayout>
