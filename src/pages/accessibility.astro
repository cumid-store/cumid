---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../config/site';

const breadcrumbs = [
  { label: 'Accessibility Statement', href: '/accessibility' },
];
---

<BaseLayout
  title="Accessibility Statement (WCAG 2.2 AA) | CUMID Stationery"
  description="CUMID commitment to digital accessibility, inclusive typography, high contrast, keyboard navigation, and WCAG 2.2 Level AA compliance."
  canonicalUrl={`${SITE.canonicalUrl}/accessibility`}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-10">
    <Breadcrumbs items={breadcrumbs} />

    <header class="space-y-3 pb-6 border-b border-charcoal-800/10">
      <span class="text-xs font-semibold tracking-wider uppercase text-lavender-700">
        Inclusivity &amp; Standards
      </span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-charcoal-900 tracking-tight">
        Accessibility Statement
      </h1>
      <p class="text-xs text-charcoal-700/70">
        Conformance Target: WCAG 2.2 Level AA · Last Meaningful Review: October 15, 2026
      </p>
    </header>

    <div class="prose prose-charcoal text-charcoal-800 text-sm sm:text-base leading-relaxed space-y-6">
      
      <h2 class="text-xl font-bold text-charcoal-900">1. Our Commitment</h2>
      <p>
        CUMID is dedicated to ensuring digital accessibility for all stationery lovers, including people with motor disabilities, visual impairments, and cognitive differences. We actively engineer our website against the World Wide Web Consortium’s <strong>Web Content Accessibility Guidelines (WCAG) 2.2 Level AA</strong>.
      </p>

      <h2 class="text-xl font-bold text-charcoal-900">2. Key Accessibility Features Implemented</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs not-prose">
        <div class="p-4 rounded-2xl bg-ivory-100 border border-charcoal-800/10 space-y-1">
          <h3 class="font-bold text-sm text-charcoal-900">Keyboard Navigability</h3>
          <p class="text-charcoal-700 leading-relaxed">
            All interactive elements—including menus, accordions, links, and favourites buttons—can be operated fully using the keyboard (Tab, Enter, Space, Escape).
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-ivory-100 border border-charcoal-800/10 space-y-1">
          <h3 class="font-bold text-sm text-charcoal-900">Visible Focus Rings</h3>
          <p class="text-charcoal-700 leading-relaxed">
            Every interactive control features a distinct 2px focus ring with 3px offset, exceeding WCAG 2.2 Focus Appearance criteria.
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-ivory-100 border border-charcoal-800/10 space-y-1">
          <h3 class="font-bold text-sm text-charcoal-900">Colour Contrast Ratios</h3>
          <p class="text-charcoal-700 leading-relaxed">
            Deep charcoal body text on warm ivory maintains a contrast ratio exceeding 12:1 (well above the 4.5:1 requirement). Pale pastel accents are never used for body text.
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-ivory-100 border border-charcoal-800/10 space-y-1">
          <h3 class="font-bold text-sm text-charcoal-900">Reduced-Motion Support</h3>
          <p class="text-charcoal-700 leading-relaxed">
            We respect the <code>prefers-reduced-motion</code> media query. Micro-animations and transitions are automatically disabled for visitors with motion sensitivity.
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-ivory-100 border border-charcoal-800/10 space-y-1">
          <h3 class="font-bold text-sm text-charcoal-900">Touch Target Dimensions</h3>
          <p class="text-charcoal-700 leading-relaxed">
            Buttons and touch controls meet the 44 &times; 44 pixel minimum touch target criteria on mobile viewports.
          </p>
        </div>

        <div class="p-4 rounded-2xl bg-ivory-100 border border-charcoal-800/10 space-y-1">
          <h3 class="font-bold text-sm text-charcoal-900">Zero Autoplay Video</h3>
          <p class="text-charcoal-700 leading-relaxed">
            No video or audio plays automatically. No carousel auto-advances. Visitors control all interactions at their own pace.
          </p>
        </div>
      </div>

      <h2 class="text-xl font-bold text-charcoal-900">3. Non-JavaScript Resilience</h2>
      <p>
        All core public pages—including our homepage, shop catalog, collection pages, individual product descriptions, FAQ accordions, and WhatsApp preorder buttons—are rendered as semantic HTML and work completely without JavaScript enabled.
      </p>

      <h2 class="text-xl font-bold text-charcoal-900">4. Feedback &amp; Assistance</h2>
      <p>
        If you encounter an accessibility barrier or need assistance navigating our pocket diary catalog, please contact us on WhatsApp at <strong>{SITE.whatsappDisplayNumber}</strong>. We welcome your feedback and treat accessibility improvements as ongoing priorities.
      </p>

    </div>
  </div>
</BaseLayout>
