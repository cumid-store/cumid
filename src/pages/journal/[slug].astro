---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StructuredData from '../../components/StructuredData.astro';
import ProductCard from '../../components/ProductCard.astro';
import { JOURNAL_ARTICLES } from '../../data/journal';
import { PRODUCTS } from '../../data/products';
import { SITE } from '../../config/site';

export function getStaticPaths() {
  return JOURNAL_ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;

const breadcrumbs = [
  { label: 'Journal', href: '/journal' },
  { label: article.title },
];

const relatedProducts = PRODUCTS.filter((p) =>
  article.relatedProductSlugs.includes(p.slug)
);
---

<BaseLayout
  title={article.seoTitle}
  description={article.seoDescription}
  canonicalUrl={`${SITE.canonicalUrl}/journal/${article.slug}`}
  schemaType="article"
  article={article}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-10">
    
    <Breadcrumbs items={breadcrumbs} />

    <!-- Article Header -->
    <header class="space-y-4 pb-8 border-b border-charcoal-800/10">
      <div class="flex items-center gap-3 text-xs text-charcoal-700/70 font-semibold uppercase tracking-wider">
        <span>{article.category}</span>
        <span>•</span>
        <span>{article.readTime}</span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-charcoal-900 tracking-tight leading-tight">
        {article.title}
      </h1>

      <p class="text-base sm:text-lg text-charcoal-700 font-serif italic leading-relaxed">
        {article.excerpt}
      </p>

      <div class="flex items-center justify-between text-xs text-charcoal-700/60 pt-2">
        <div class="flex items-center gap-2">
          <span class="font-semibold text-charcoal-800">{article.author.name}</span>
          <span>({article.author.role})</span>
        </div>
        <div>
          <span>Published: {article.publishedDate}</span>
          {article.updatedDate !== article.publishedDate && (
            <span class="ml-2">· Updated: {article.updatedDate}</span>
          )}
        </div>
      </div>
    </header>

    <!-- Article Body Content -->
    <div class="prose prose-charcoal max-w-none text-charcoal-800 leading-relaxed text-sm sm:text-base space-y-6">
      <div set:html={article.content.replace(/\n\n/g, '<br/><br/>').replace(/### (.*?)\n/g, '<h2 class="text-xl sm:text-2xl font-bold text-charcoal-900 mt-8 mb-3 tracking-tight">$1</h2>').replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" class="text-lavender-700 underline font-semibold hover:text-lavender-900">$1</a>')} />
    </div>

    <!-- Related Covers Mentioned in Article -->
    {relatedProducts.length > 0 && (
      <div class="pt-12 border-t border-charcoal-800/10 space-y-6">
        <h2 class="text-2xl font-bold text-charcoal-900">
          Covers mentioned in this article
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {relatedProducts.map((prod) => (
            <ProductCard product={prod} ctaPlacement="featured_grid" />
          ))}
        </div>
      </div>
    )}

    <!-- Return to Journal -->
    <div class="pt-8 border-t border-charcoal-800/10 flex justify-between items-center text-xs">
      <a href="/journal" class="font-semibold text-lavender-700 hover:text-lavender-900 underline underline-offset-4">
        &larr; Back to all articles
      </a>
      <a href="/shop" class="font-semibold text-charcoal-900 hover:text-lavender-700">
        Browse pocket diaries &rarr;
      </a>
    </div>

  </div>

  <StructuredData
    type="article"
    article={article}
  />
  <StructuredData
    type="breadcrumbs"
    breadcrumbs={breadcrumbs.map((b) => ({ name: b.label, item: b.href || Astro.url.pathname }))}
  />
</BaseLayout>
