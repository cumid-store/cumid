---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { JOURNAL_ARTICLES } from '../../data/journal';
import { SITE } from '../../config/site';

const breadcrumbs = [
  { label: 'Journal', href: '/journal' },
];
---

<BaseLayout
  title="The CUMID Journal | Daily Writing & Stationery Ergonomics"
  description="Original essays, format ergonomics, notebook habits, and low-pressure prompts for pocket diary enthusiasts."
  canonicalUrl={`${SITE.canonicalUrl}/journal`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-12">
    
    <Breadcrumbs items={breadcrumbs} />

    <!-- Journal Header -->
    <div class="space-y-4 max-w-2xl">
      <span class="text-xs font-semibold tracking-wider uppercase text-lavender-700">
        Stories &amp; Ergonomics
      </span>
      <h1 class="text-4xl sm:text-5xl font-semibold text-charcoal-900 tracking-tight">
        The CUMID Journal
      </h1>
      <p class="text-base text-charcoal-700 leading-relaxed">
        Reflections on stationery design, wrist ergonomics, and practical ways to make daily journaling feel inviting instead of intimidating.
      </p>
    </div>

    <!-- Article Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {JOURNAL_ARTICLES.map((article) => (
        <article class="p-6 rounded-sm bg-ivory-100 border border-charcoal-800/10   transition-all duration-300 flex flex-col justify-between space-y-5">
          <div class="space-y-4">
            <div class="flex items-center justify-between text-xs text-charcoal-700/60 font-semibold uppercase tracking-wider">
              <span>{article.category}</span>
              <span>{article.readTime}</span>
            </div>

            <h2 class="text-xl font-bold text-charcoal-900 hover:text-lavender-700 transition-colors leading-snug">
              <a href={`/journal/${article.slug}`}>
                {article.title}
              </a>
            </h2>

            <p class="text-xs sm:text-sm text-charcoal-700 leading-relaxed line-clamp-3">
              {article.excerpt}
            </p>
          </div>

          <div class="pt-4 border-t border-charcoal-800/10 flex items-center justify-between text-xs">
            <span class="text-charcoal-700/60">{article.publishedDate}</span>
            <a href={`/journal/${article.slug}`} class="font-semibold text-charcoal-900 hover:text-lavender-700">
              Read article &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>

  </div>
</BaseLayout>
