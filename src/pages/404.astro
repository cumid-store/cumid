---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
---

<BaseLayout
  title="Page Not Found (404) | CUMID Stationery"
  description="The page you are looking for does not exist on cumid.store."
  noindex={true}
>
  <div class="max-w-2xl mx-auto px-4 py-24 sm:py-32 text-center space-y-6">
    <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-peach-100 text-peach-700 font-semibold text-3xl">
      404
    </div>

    <div class="space-y-2">
      <h1 class="text-3xl sm:text-4xl font-semibold text-charcoal-900 tracking-tight">
        Blank page syndrome.
      </h1>
      <p class="text-sm sm:text-base text-charcoal-700 max-w-md mx-auto leading-relaxed">
        The link you followed seems to have flipped past our last page. Don't worry—your favourite covers are still waiting in our shop.
      </p>
    </div>

    <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-3.5">
      <a href="/" class="btn-primary text-xs w-full sm:w-auto">
        Return to Home
      </a>
      <a href="/shop" class="btn-secondary text-xs w-full sm:w-auto">
        Explore Pocket Diaries
      </a>
    </div>

    <p class="text-xs text-charcoal-700/60 pt-6">
      Looking for a specific batch? Ask us on WhatsApp: <a href={SITE.whatsappBaseUrl} class="underline font-mono">{SITE.whatsappDisplayNumber}</a>
    </p>
  </div>
</BaseLayout>
