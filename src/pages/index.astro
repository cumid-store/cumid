---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import CatalogueGrid from '../components/islands/CatalogueGrid';
import FAQAccordion from '../components/FAQAccordion.astro';
import { getFeaturedProducts, PRODUCTS } from '../data/products';
import { COLLECTION_LIST } from '../data/collections';
---
<BaseLayout title="CUMID — Square Pocket Diaries with Personality" description="Browse floral, funny, Hinglish, car and jet diary covers. Square pocket diaries with top spiral binding. Preorder for ₹149 plus ₹50 shipping per order. Delivery within 14 days of payment confirmation." preloadImage="/brand/journaling-afternoon.webp" schemaType="website">
  <Hero />
  <section class="store-width catalogue-section" id="featured-covers">
    <div class="section-heading">
      <div>
        <p class="eyebrow">The cover edit</p>
        <h2>Find your favourite.</h2>
      </div>
      <a class="text-link" id="home-all-covers-link" href="/shop">All {PRODUCTS.length} covers ↗</a>
    </div>
    <nav class="collection-links" aria-label="Cover collections" id="collections">
      {COLLECTION_LIST.map(c=><a href={`/collections/${c.slug}`}>{c.name}</a>)}
    </nav>
    <CatalogueGrid client:load initialProducts={getFeaturedProducts()} isFeatured={true} />
    <p class="catalogue-note">Digital diary mockups shown. Square pocket format, with spiral binding along the top. Preorders are open. ₹149 per diary + ₹50 shipping per order. Delivery within 14 days of payment confirmation.</p>
  </section>
  <section class="enquiry-strip">
    <div class="store-width enquiry-layout">
      <div>
        <p class="eyebrow">Found your cover?</p>
        <h2>Your next diary starts here.</h2>
      </div>
      <div>
        <p>Choose a cover and quantity, review your total, then send your preorder to us on WhatsApp. One diary is ₹199 including shipping.</p>
        <a class="text-link" href="/checkout">Start your preorder ↗</a>
      </div>
    </div>
  </section>
  <FAQAccordion limit={4} />
</BaseLayout>
