---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { getFeaturedProducts, PRODUCTS } from '../data/products';
import { COLLECTION_LIST } from '../data/collections';
---
<BaseLayout title="CUMID — Square Pocket Diaries with Personality" description="Browse floral, funny, Hinglish, car and jet diary covers. Square pocket diaries with top spiral binding. Ask CUMID about preorders on WhatsApp." preloadImage="/brand/journaling-afternoon.webp" schemaType="website">
  <Hero />
  <section class="store-width catalogue-section" id="featured-covers">
    <div class="section-heading"><div><p class="eyebrow">The cover edit</p><h2>Find your favourite.</h2></div><a class="text-link" href="/shop">All {PRODUCTS.length} covers ↗</a></div>
    <nav class="collection-links" aria-label="Cover collections" id="collections">{COLLECTION_LIST.map(c=><a href={`/collections/${c.slug}`}>{c.name}</a>)}</nav>
    <div class="cover-grid">{getFeaturedProducts().map(product=><ProductCard product={product} />)}</div>
    <p class="catalogue-note">Digital diary mockups shown. Square pocket format, with spiral binding along the top. All designs are currently sold out; next-batch enquiries are open.</p>
  </section>
  <section class="enquiry-strip"><div class="store-width enquiry-layout"><div><p class="eyebrow">Found your cover?</p><h2>Let’s take it to WhatsApp.</h2></div><div><p>Send us the design you like. We’ll share the price, paper details and availability before you decide. An enquiry doesn’t reserve a diary.</p><a class="text-link" href="/how-preorders-work">How preorders work ↗</a></div></div></section>
  <FAQAccordion limit={4} />
</BaseLayout>
