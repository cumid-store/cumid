---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { PRODUCTS } from '../../data/products';
import { COLLECTION_LIST } from '../../data/collections';
---
<BaseLayout title="Shop Square Pocket Diaries | CUMID" description="Explore 13 CUMID cover designs: florals, Hinglish humour, cats, ghosts, doodles, cars and jets. All currently sold out. WhatsApp preorder enquiries open.">
  <div class="store-width catalogue-section">
    <Breadcrumbs items={[{label:'Shop',href:'/shop'}]} />
    <div class="shop-heading"><p class="eyebrow">The catalogue</p><h1>Choose your cover.</h1><p>Same square pocket format. Thirteen different personalities.<br />All sold out for now. Ask about price and next-batch availability on WhatsApp.</p></div>
    <nav class="collection-links" id="collections" aria-label="Cover collections"><a href="/shop" aria-current="page">All covers ({PRODUCTS.length})</a>{COLLECTION_LIST.map(c=><a href={`/collections/${c.slug}`}>{c.name}</a>)}</nav>
    <div class="cover-grid">{PRODUCTS.map(product=><ProductCard product={product} />)}</div>
    <p class="catalogue-note">These are cover design previews, not photographs of finished stock. <a class="text-link" href="/how-preorders-work">How preorders work ↗</a></p>
  </div>
</BaseLayout>
