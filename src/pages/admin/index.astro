---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminOverview from '../../components/islands/admin/AdminOverview';
import { SITE } from '../../config/site';
---

<BaseLayout
  title="Store Operations & Admin | CUMID Stationery"
  description="Private store management overview for CUMID."
  canonicalUrl={`${SITE.canonicalUrl}/admin`}
  noindex={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <AdminOverview client:load />
  </div>
</BaseLayout>
