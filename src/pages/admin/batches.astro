---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminBatchesManager from '../../components/islands/admin/AdminBatchesManager';
import { SITE } from '../../config/site';
---

<BaseLayout
  title="Manage Production Batches | CUMID Admin"
  description="Manage physical printing and spiral binding batches, quantities, and dispatch timelines."
  canonicalUrl={`${SITE.canonicalUrl}/admin/batches`}
  noindex={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <AdminBatchesManager client:load />
  </div>
</BaseLayout>
