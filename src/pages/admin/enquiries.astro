---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminEnquiriesManager from '../../components/islands/admin/AdminEnquiriesManager';
import { SITE } from '../../config/site';
---

<BaseLayout
  title="Preorder Enquiries Inbox | CUMID Admin"
  description="Manage incoming WhatsApp preorder enquiries and customer followups."
  canonicalUrl={`${SITE.canonicalUrl}/admin/enquiries`}
  noindex={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <AdminEnquiriesManager client:load />
  </div>
</BaseLayout>
