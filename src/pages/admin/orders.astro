---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminOrdersManager from '../../components/islands/admin/AdminOrdersManager';
import { SITE } from '../../config/site';
---

<BaseLayout
  title="Manage Orders | CUMID Admin"
  description="Manage customer orders, status workflows, and courier tracking."
  canonicalUrl={`${SITE.canonicalUrl}/admin/orders`}
  noindex={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <AdminOrdersManager client:load />
  </div>
</BaseLayout>
