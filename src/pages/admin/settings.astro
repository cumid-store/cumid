---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminSettingsManager from '../../components/islands/admin/AdminSettingsManager';
import { SITE } from '../../config/site';
---

<BaseLayout
  title="Store Operations Settings | CUMID Admin"
  description="Manage customer support channels, delivery guidelines, and DPDP compliance retention rules."
  canonicalUrl={`${SITE.canonicalUrl}/admin/settings`}
  noindex={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <AdminSettingsManager client:load />
  </div>
</BaseLayout>
