---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminProductsManager from '../../components/islands/admin/AdminProductsManager';
import { SITE } from '../../config/site';
---

<BaseLayout
  title="Manage Catalogue & Pricing | CUMID Admin"
  description="Manage products, confirmed prices in paise, availability status, and staging."
  canonicalUrl={`${SITE.canonicalUrl}/admin/products`}
  noindex={true}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <AdminProductsManager client:load />
  </div>
</BaseLayout>
