---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE, buildGeneralWhatsAppUrl } from '../config/site';

const breadcrumbs = [
  { label: 'Contact', href: '/contact' },
];

const generalWhatsAppUrl = buildGeneralWhatsAppUrl('general contact');
---

<BaseLayout
  title="Contact Us | CUMID Stationery"
  description="Get in touch with CUMID on WhatsApp for preorder enquiries, cover suggestions, and questions. Customer WhatsApp: +91 9201871597."
  canonicalUrl={`${SITE.canonicalUrl}/contact`}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-12">
    
    <Breadcrumbs items={breadcrumbs} />

    <header class="space-y-4">
      <span class="text-xs font-semibold tracking-wider uppercase text-lavender-700">
        Direct Communication
      </span>
      <h1 class="text-4xl sm:text-5xl font-semibold text-charcoal-900 tracking-tight">
        Get in Touch
      </h1>
      <p class="text-base sm:text-lg text-charcoal-700 leading-relaxed">
        Ask about a diary on WhatsApp, or email support@cumid.store for support and privacy questions.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
      <!-- Official WhatsApp Card -->
      <div class="p-8 rounded-sm bg-ivory-100 border border-charcoal-800/10  space-y-5 flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-12 h-12 rounded-sm bg-green-100 flex items-center justify-center text-green-700">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91C2.13 13.66 2.59 15.36 3.45 16.86L2.05 22L7.3 20.62C8.75 21.41 10.38 21.83 12.04 21.83C17.5 21.83 21.95 17.38 21.95 11.92C21.95 9.27 20.92 6.78 19.05 4.91C17.18 3.03 14.69 2 12.04 2M12.05 3.67C14.25 3.67 16.31 4.53 17.87 6.09C19.42 7.65 20.28 9.72 20.28 11.92C20.28 16.46 16.58 20.15 12.04 20.15C10.56 20.15 9.11 19.76 7.85 19L7.55 18.83L4.43 19.65L5.26 16.61L5.06 16.29C4.24 14.99 3.81 13.47 3.81 11.91C3.81 7.37 7.5 3.67 12.05 3.67Z" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-charcoal-900">Official WhatsApp</h2>
          <p class="text-xs sm:text-sm text-charcoal-700 leading-relaxed">
            Fastest response for batch schedules, specification enquiries, and cover suggestions.
          </p>
          <div class="pt-2 font-mono text-base font-bold text-charcoal-900">
            {SITE.whatsappDisplayNumber}
          </div>
        </div>

        <div class="pt-4">
          <a
            href={generalWhatsAppUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-whatsapp w-full text-xs"
          >
            <span>Start WhatsApp Chat</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Working Hours & Expectations -->
      <div class="p-8 rounded-sm bg-ivory-100 border border-charcoal-800/10  space-y-4">
        <h2 class="text-xl font-bold text-charcoal-900">What to Expect</h2>
        <div class="space-y-3 text-xs sm:text-sm text-charcoal-700 leading-relaxed">
          <p>
            • <strong>Response Times:</strong> We answer enquiries personally. Response times may vary.
          </p>
          <p>
            • <strong>No Automated Bots:</strong> You will converse with a real human who understands our cover concepts and manufacturing timeline.
          </p>
          <p>
            • <strong>Zero Obligation:</strong> Enquiring does not create an order or spam your phone number.
          </p>
          <p>
            • <strong>Market Scope:</strong> We currently serve stationery lovers across India in Indian Rupees (INR).
          </p>
        </div>

        <div class="pt-4 border-t border-charcoal-800/15"><h3 class="font-medium">Email support</h3><a class="text-link" href="mailto:support@cumid.store">support@cumid.store</a></div>
      </div>

    </div>

  </div>
</BaseLayout>
