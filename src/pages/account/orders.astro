---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CustomerOrdersList from '../../components/islands/CustomerOrdersList';
import { SITE } from '../../config/site';

const breadcrumbs = [
  { label: 'Account', href: '/account' },
  { label: 'My Orders', href: '/account/orders' },
];
---

<BaseLayout
  title="My Orders | CUMID Stationery"
  description="Track your agreed CUMID diary preorder orders, production progress, and dispatch status."
  canonicalUrl={`${SITE.canonicalUrl}/account/orders`}
  noindex={true}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-10">
    <Breadcrumbs items={breadcrumbs} />

    <header class="space-y-3 pb-6 border-b border-charcoal-800/10">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <span class="text-xs font-semibold tracking-wider uppercase text-lavender-700">
            Customer Portal
          </span>
          <h1 class="text-3xl sm:text-4xl font-extrabold text-charcoal-900 tracking-tight">
            My Orders
          </h1>
          <p class="text-xs sm:text-sm text-charcoal-700 mt-1">
            Confirmed preorder batch orders, agreed pricing snapshots, and dispatch tracking.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <a href="/account/favourites" class="btn-secondary text-xs py-2 px-3">
            Saved Favourites
          </a>
          <a href="/account" class="btn-secondary text-xs py-2 px-3">
            Account Profile
          </a>
        </div>
      </div>
    </header>

    <!-- Orders List Island -->
    <CustomerOrdersList client:load />

    <!-- Order FAQ & Safety Notice -->
    <div class="p-5 rounded-2xl bg-ivory-100 border border-charcoal-800/10 text-xs text-charcoal-700 space-y-2">
      <p class="font-bold text-charcoal-900">How Order Confirmation Works:</p>
      <ul class="list-disc pl-5 space-y-1">
        <li>Preorders originate from WhatsApp conversation where batch availability and delivery details are mutually agreed.</li>
        <li>Once confirmed, an order draft is recorded here with your snapshot pricing and items.</li>
        <li>For any order modifications or delivery address changes before dispatch, message us on WhatsApp with your order reference.</li>
      </ul>
    </div>
  </div>
</BaseLayout>
