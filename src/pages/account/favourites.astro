---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FavouritesList from '../../components/islands/FavouritesList';
import { SITE } from '../../config/site';

const breadcrumbs = [
  { label: 'Account', href: '/account' },
  { label: 'Saved Favourites' },
];
---

<BaseLayout
  title="Saved Favourites | CUMID Stationery"
  description="Your curated list of favourite CUMID pocket diary covers."
  canonicalUrl={`${SITE.canonicalUrl}/account/favourites`}
  noindex={true}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-10">
    <Breadcrumbs items={breadcrumbs} />

    <header class="space-y-3 pb-6 border-b border-charcoal-800/10">
      <span class="text-xs font-semibold tracking-wider uppercase text-lavender-700">
        Wishlist &amp; Saved
      </span>
      <h1 class="text-3xl sm:text-4xl font-semibold text-charcoal-900 tracking-tight">
        Saved Favourites
      </h1>
      <p class="text-sm text-charcoal-700">
        Review your favourite covers and compare designs before placing your preorder.
      </p>
    </header>

    <!-- Favourites List Island -->
    <FavouritesList client:load />

    <div class="pt-8 border-t border-charcoal-800/10 flex items-center justify-between text-xs">
      <a href="/shop" class="font-semibold text-lavender-700 hover:text-lavender-900 underline underline-offset-4">
        &larr; Browse more covers in Shop
      </a>
      <a href="/how-preorders-work" class="text-charcoal-700 hover:text-charcoal-900">
        How batch preorders work &rarr;
      </a>
    </div>
  </div>
</BaseLayout>
