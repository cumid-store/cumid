---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import CustomerOrderDetail from '../../../components/islands/CustomerOrderDetail';
import { SITE } from '../../../config/site';

export const prerender = false;

const { id } = Astro.params;

const breadcrumbs = [
  { label: 'Account', href: '/account' },
  { label: 'My Orders', href: '/account/orders' },
  { label: id || 'Order Details' },
];
---

<BaseLayout
  title={`Order Details | CUMID Stationery`}
  description="View your agreed CUMID diary preorder items, status timeline, and delivery tracking."
  canonicalUrl={`${SITE.canonicalUrl}/account/orders/${id}`}
  noindex={true}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-8">
    <Breadcrumbs items={breadcrumbs} />

    <!-- Order Detail Island -->
    <CustomerOrderDetail client:load orderId={id!} />
  </div>
</BaseLayout>
