---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Careers from '../../components/islands/Careers';
import '../../styles/commerce.css';
---
<BaseLayout title="Submit Your Task | CUMID Careers" description="Share your assigned task with CUMID using links to your work (Drive, Figma, GitHub, etc.)." noindex={true}>
 <section class="max-w-4xl mx-auto px-5 py-12">
  <header class="mb-10">
    <a class="text-sm underline" href="/careers">← Careers</a>
    <h1 class="text-4xl mt-4 mb-4">Show us your work.</h1>
    <p>Use the account you applied with. Add your task, link your work, and you are done.</p>
    <div class="mt-4 p-3.5 bg-amber-50 dark:bg-amber-950/40 border border-amber-200 dark:border-amber-800 rounded-lg text-sm flex items-center justify-between flex-wrap gap-2">
      <span>Prefer Google Forms? You can also submit your task work directly via our Google Form.</span>
      <a href="https://forms.gle/N5PXNTiNbRtZeH7f7" target="_blank" rel="noopener noreferrer" class="font-semibold underline text-amber-900 dark:text-amber-200">Open Google Form →</a>
    </div>
  </header>
  <Careers portal client:load />
 </section>
</BaseLayout>
