---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Signing In... | CUMID Stationery"
  noindex={true}
>
  <div class="max-w-md mx-auto px-4 py-24 text-center space-y-4">
    <div class="w-12 h-12 mx-auto rounded-full bg-lavender-100 flex items-center justify-center animate-spin">
      <svg class="w-6 h-6 text-lavender-700" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
    </div>
    <h1 class="text-xl font-bold text-charcoal-900">Finalizing sign-in...</h1>
    <p class="text-xs text-charcoal-700">Connecting your Google account with CUMID favourites.</p>

    <script>
      import { supabase, isSupabaseConfigured, isAllowedAdminEmail } from '../../lib/supabase';

      async function handleCallback() {
        if (!isSupabaseConfigured || !supabase) {
          window.location.replace('/account');
          return;
        }

        const urlParams = new URLSearchParams(location.search);
        const code = urlParams.get('code');
        const nextUrl = urlParams.get('next') || urlParams.get('redirect');

        // Strip the one-time code before navigating
        history.replaceState(null, '', '/auth/callback');
        if (!code) { 
          location.replace('/account?signin_error=1'); 
          return; 
        }

        try {
          const { data, error } = await supabase.auth.exchangeCodeForSession(code);
          if (error || !data?.session) {
            location.replace('/account?signin_error=1');
            return;
          }

          const userEmail = data.session.user?.email;

          // If specifically directed to /admin and user is an authorized admin
          if (nextUrl === '/admin' && isAllowedAdminEmail(userEmail)) {
            location.replace('/admin');
            return;
          }

          if (nextUrl && nextUrl.startsWith('/') && nextUrl !== '/account') {
            location.replace(nextUrl);
            return;
          }

          // User request: after signin completed redirected to the shop page
          location.replace('/shop');
        } catch {
          location.replace('/account?signin_error=1');
        }
      }

      handleCallback();
    </script>
  </div>
</BaseLayout>
