---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { SITE } from '../config/site';

const breadcrumbs = [
  { label: 'FAQ', href: '/faq' },
];
---

<BaseLayout
  title="Frequently Asked Questions | CUMID Stationery"
  description="Answers to common questions regarding CUMID pocket diaries, WhatsApp batch preorders, shipping across India, and payment safety."
  canonicalUrl={`${SITE.canonicalUrl}/faq`}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-8">
    <Breadcrumbs items={breadcrumbs} />
    <FAQAccordion limit={undefined} showSchema={true} headingLevel="h1" />
  </div>
</BaseLayout>
