---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StructuredData from '../../components/StructuredData.astro';
import { COLLECTION_LIST } from '../../data/collections';
import { getProductsByCollection } from '../../data/products';
import { SITE } from '../../config/site';

export function getStaticPaths() {
  return COLLECTION_LIST.map((col) => ({
    params: { collection: col.slug },
    props: { collection: col },
  }));
}

const { collection } = Astro.props;
const products = getProductsByCollection(collection.slug);

const breadcrumbs = [
  { label: 'Shop', href: '/shop' },
  { label: 'Collections', href: '/shop#collections' },
  { label: collection.name },
];
---

<BaseLayout
  title={collection.metaTitle}
  description={collection.metaDescription}
  canonicalUrl={`${SITE.canonicalUrl}/collections/${collection.slug}`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-10">
    
    <Breadcrumbs items={breadcrumbs} />

    <!-- Collection Header -->
    <div class="p-8 sm:p-12 rounded-3xl border border-charcoal-800/10 space-y-4 shadow-soft-sm" style={`background-color: ${collection.accentBg};`}>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-ivory-100/90 text-charcoal-800 border border-charcoal-800/10">
        <span>Collection</span>
        <span>•</span>
        <span style={`color: ${collection.themeColor};`}>{collection.personalityPill}</span>
      </div>

      <h1 class="text-4xl sm:text-5xl font-extrabold text-charcoal-900 tracking-tight">
        {collection.name} Collection
      </h1>

      <p class="text-lg text-charcoal-800 font-medium">
        {collection.headline}
      </p>

      <p class="text-sm text-charcoal-700 max-w-2xl leading-relaxed">
        {collection.description}
      </p>
    </div>

    <!-- Products in this Collection -->
    <div class="space-y-6">
      <div class="flex items-center justify-between pb-2 border-b border-charcoal-800/10">
        <h2 class="text-lg font-bold text-charcoal-900">
          Available Covers ({products.length})
        </h2>
        <span class="text-xs text-charcoal-700/70">All designs currently sold out</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        {products.map((product) => (
          <ProductCard product={product} ctaPlacement="featured_grid" />
        ))}
      </div>
    </div>

    <!-- Other Collections Navigation -->
    <div class="pt-12 border-t border-charcoal-800/10 space-y-6">
      <h3 class="text-xl font-bold text-charcoal-900 text-center">
        Explore other personality themes
      </h3>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {COLLECTION_LIST.filter((c) => c.slug !== collection.slug).map((c) => (
          <a
            href={`/collections/${c.slug}`}
            class="p-5 rounded-2xl bg-ivory-100 hover:bg-ivory-300 border border-charcoal-800/10 transition-colors flex items-center justify-between"
          >
            <div>
              <span class="font-bold text-sm text-charcoal-900 block">{c.name}</span>
              <span class="text-xs text-charcoal-700/70">{c.personalityPill}</span>
            </div>
            <span class="text-charcoal-800 font-bold">&rarr;</span>
          </a>
        ))}
      </div>
    </div>

  </div>

  <StructuredData
    type="breadcrumbs"
    breadcrumbs={breadcrumbs.map((b) => ({ name: b.label, item: b.href || Astro.url.pathname }))}
  />
</BaseLayout>
