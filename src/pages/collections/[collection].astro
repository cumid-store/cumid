---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StructuredData from '../../components/StructuredData.astro';
import CatalogueGrid from '../../components/islands/CatalogueGrid';
import { COLLECTION_LIST } from '../../data/collections';
import { getProductsByCollection } from '../../data/products';
import { SITE } from '../../config/site';

export function getStaticPaths() {
  return COLLECTION_LIST.map((col) => ({
    params: { collection: col.slug },
    props: { collection: col },
  }));
}

const { collection } = Astro.props;
const products = getProductsByCollection(collection.slug);

const breadcrumbs = [
  { label: 'Shop', href: '/shop' },
  { label: 'Collections', href: '/shop#collections' },
  { label: collection.name },
];
---

<BaseLayout
  title={collection.metaTitle}
  description={collection.metaDescription}
  canonicalUrl={`${SITE.canonicalUrl}/collections/${collection.slug}`}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16 space-y-10">
    
    <Breadcrumbs items={breadcrumbs} />

    <div class="shop-heading">
      <p class="eyebrow">The catalogue</p>
      <h1>{collection.name} Collection</h1>
      <p>{collection.description}</p>
    </div>
    <nav class="collection-links" id="collections" aria-label="Cover collections">
      <a href="/shop">All covers</a>
      {COLLECTION_LIST.map(c => <a href={`/collections/${c.slug}`} aria-current={c.slug === collection.slug ? 'page' : undefined}>{c.name}</a>)}
    </nav>
    <!-- Products in this Collection -->
    <div class="space-y-6">
      <div class="flex items-center justify-between pb-2 border-b border-charcoal-800/10">
        <h2 class="text-lg font-bold text-charcoal-900" id="collection-count-heading">
          Cover designs ({products.length})
        </h2>
        <span class="text-xs text-charcoal-700/70">All designs currently sold out</span>
      </div>

      <CatalogueGrid client:load initialProducts={products} collectionSlug={collection.slug} collectionName={collection.name} />
    </div>


  </div>

  <StructuredData
    type="breadcrumbs"
    breadcrumbs={breadcrumbs.map((b) => ({ name: b.label, item: b.href || Astro.url.pathname }))}
  />
</BaseLayout>
