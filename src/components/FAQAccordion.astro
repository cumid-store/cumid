---
import { FAQ_ITEMS, type FAQItem } from '../data/faq';
import StructuredData from './StructuredData.astro';

interface Props {
  items?: FAQItem[];
  limit?: number;
  showSchema?: boolean;
}

const { items = FAQ_ITEMS, limit, showSchema = true } = Astro.props;
const displayItems = limit ? items.slice(0, limit) : items;
---

<section class="py-16 sm:py-24 bg-ivory-100 border-t border-charcoal-800/10" id="faq">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    <div class="text-center space-y-3">
      <span class="text-xs font-semibold tracking-wider uppercase text-lavender-700">
        Direct Answers
      </span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-charcoal-900">
        Frequently asked questions
      </h2>
      <p class="text-sm text-charcoal-700">
        Everything you need to know about batch preorders, WhatsApp enquiries, and product formats.
      </p>
    </div>

    <div class="space-y-4">
      {displayItems.map((faq) => (
        <details
          class="group rounded-2xl bg-ivory-200 border border-charcoal-800/10 p-5 transition-all duration-200 open:bg-ivory-300/60"
          id={`faq-${faq.id}`}
        >
          <summary class="flex items-center justify-between cursor-pointer list-none font-bold text-sm sm:text-base text-charcoal-900 select-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lavender-600 rounded-lg py-1">
            <span>{faq.question}</span>
            <span class="ml-4 flex-shrink-0 text-charcoal-700 group-open:rotate-180 transition-transform duration-200">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </span>
          </summary>
          <div class="pt-3.5 text-xs sm:text-sm text-charcoal-700 leading-relaxed border-t border-charcoal-800/5 mt-3">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Structured Data for FAQ items -->
    {showSchema && (
      <StructuredData
        type="faq"
        faqs={displayItems.map((f) => ({ question: f.question, answer: f.answer }))}
      />
    )}
  </div>
</section>
