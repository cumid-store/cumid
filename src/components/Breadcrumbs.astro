---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="py-3 text-xs text-charcoal-700/70">
  <ol class="flex items-center space-x-2 flex-wrap">
    <li>
      <a href="/" class="hover:text-charcoal-900 transition-colors focus-visible:outline-none focus-visible:underline">
        Home
      </a>
    </li>
    {items.map((item, index) => (
      <li class="flex items-center space-x-2">
        <span class="text-charcoal-400" aria-hidden="true">/</span>
        {item.href && index < items.length - 1 ? (
          <a
            href={item.href}
            class="hover:text-charcoal-900 transition-colors focus-visible:outline-none focus-visible:underline"
          >
            {item.label}
          </a>
        ) : (
          <span class="text-charcoal-900 font-medium" aria-current="page">
            {item.label}
          </span>
        )}
      </li>
    ))}
  </ol>
</nav>
