---
import { SITE } from '../config/site';
---

<footer class="bg-charcoal-900 text-ivory-100 border-t border-charcoal-700/40 mt-auto">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      
      <!-- Brand & Mission Column -->
      <div class="md:col-span-1 space-y-4">
        <a href="/" class="inline-block" aria-label="CUMID Home">
          <img
            src="/brand/logo-dark.svg"
            alt="CUMID Pocket Diaries"
            class="h-16 w-20"
            width="80"
            height="70"
          />
        </a>
        <p class="text-xs text-charcoal-300 leading-relaxed">
          {SITE.description}
        </p>

      </div>

      <!-- Shop & Collections -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold tracking-wider uppercase text-lavender-300">
          Cover Collections
        </h3>
        <ul class="space-y-2 text-xs text-charcoal-300">
          {SITE.footerLinks.shop.map((link) => (
            <li>
              <a href={link.href} class="hover:text-ivory-100 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Information & Preorders -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold tracking-wider uppercase text-lavender-300">
          How It Works
        </h3>
        <ul class="space-y-2 text-xs text-charcoal-300">
          {SITE.footerLinks.info.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.isExternal ? '_blank' : undefined}
                rel={link.isExternal ? 'noopener noreferrer' : undefined}
                class="hover:text-ivory-100 transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        <div class="pt-2 text-[11px] text-charcoal-300/80">
          <p><a href={`mailto:${SITE.supportEmail}`} class="hover:underline text-ivory-100">{SITE.supportEmail}</a></p>
          <p>Customer WhatsApp:</p>
          <a href={SITE.whatsappBaseUrl} class="text-peach-200 hover:underline font-mono text-xs">
            {SITE.whatsappDisplayNumber}
          </a>
        </div>
      </div>

      <!-- Legal & Privacy Choices -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold tracking-wider uppercase text-lavender-300">
          Policies
        </h3>
        <ul class="space-y-2 text-xs text-charcoal-300">
          {SITE.footerLinks.legal.map((link) => (
            <li>
              <a href={link.href} class="hover:text-ivory-100 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <!-- Persistent Cookie & Privacy Preferences Trigger -->
            <button
              type="button"
              data-open-privacy
              class="hover:text-ivory-100 text-left transition-colors underline underline-offset-2 text-xs text-lavender-300"
            >
              Cookie &amp; Privacy Preferences
            </button>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Notice & Copyright -->
    <div class="mt-12 pt-8 border-t border-charcoal-700/50 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-charcoal-300">
      <p class="text-center md:text-left">
        &copy; {new Date().getFullYear()} CUMID. All rights reserved.
      </p>
      <div class="flex items-center gap-4 text-[11px]">
        <span>No ready stock · Preorders on WhatsApp</span>
        <span>•</span>
        <a href="/how-preorders-work" class="underline hover:text-ivory-100">Enquiry Policy</a>
        <span>•</span>
        <a href="/accessibility" class="underline hover:text-ivory-100">Accessibility</a>
      </div>
    </div>
  </div>
</footer>

<script>
  document.querySelector('[data-open-privacy]')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('cumid:open-consent-modal'));
  });
</script>
