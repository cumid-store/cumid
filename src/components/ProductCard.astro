---
import type { Product } from '../types/product';
import FavouritesButton from './islands/FavouritesButton';
import DiaryMockup from './DiaryMockup.astro';
import ProductPrice from './islands/ProductPrice';
interface Props { product: Product; ctaPlacement?: string; }
const { product } = Astro.props;
---
<article class="product-card">
  <div class="product-art">
    <a href={`/products/${product.slug}`} aria-label={`View ${product.name} pocket diary details`}>
      <DiaryMockup src={`/products/${product.slug}/thumbnail.webp`} alt={`${product.name} square top-spiral diary mockup. ${product.images[0].alt}`} />
    </a>
    <div class="product-save"><FavouritesButton client:visible productId={product.id} productName={product.name} iconOnly={true} /></div>
  </div>
  <div class="product-meta"><span>{product.collectionName}</span><span>{product.isSoldOut ? 'Unavailable' : 'Preorders open'}</span></div>
  <h3><a href={`/products/${product.slug}`}>{product.name}</a></h3>
  <p>{product.tagline}</p>
  <ProductPrice />
  <a class="product-details" href={`/products/${product.slug}`}>View diary &amp; preorder <span aria-hidden="true">↗</span></a>
</article>
