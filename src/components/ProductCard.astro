---
import type { Product } from '../types/product';
import FavouritesButton from './islands/FavouritesButton';
import WhatsAppPreorderButton from './islands/WhatsAppPreorderButton';

interface Props {
  product: Product;
  ctaPlacement?: 'hero' | 'featured_grid' | 'product_gallery' | 'product_detail' | 'footer' | 'nav' | 'faq';
}

const { product, ctaPlacement = 'featured_grid' } = Astro.props;
const primaryImage = product.images[0];
---

<article class="group relative rounded-2xl bg-ivory-100 border border-charcoal-800/10 overflow-hidden shadow-soft-sm hover:shadow-soft transition-all duration-300 flex flex-col justify-between">
  <!-- Card Media Container -->
  <div class="relative aspect-square w-full bg-ivory-200 overflow-hidden">
    <a href={`/products/${product.slug}`} class="block w-full h-full" aria-label={`View ${product.name} pocket diary details`}>
      <img
        src={primaryImage.src}
        alt={primaryImage.alt}
        width={600}
        height={600}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
    </a>

    <!-- Top Left Badges: Sold Out + Design Preview -->
    <div class="absolute top-3 left-3 flex flex-col gap-1.5 pointer-events-none">
      <span class="badge-sold-out shadow-sm">
        Sold Out
      </span>
      {product.isDesignPreview && (
        <span class="badge-preview shadow-sm">
          Design preview
        </span>
      )}
    </div>

    <!-- Top Right Favourites Action -->
    <div class="absolute top-3 right-3 z-10">
      <FavouritesButton
        client:load
        productId={product.id}
        productName={product.name}
        iconOnly={true}
      />
    </div>
  </div>

  <!-- Card Body Content -->
  <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
    <div class="space-y-1.5">
      <div class="flex items-center justify-between text-xs text-charcoal-700/60 font-semibold uppercase tracking-wider">
        <span>{product.collectionName}</span>
        <span class="font-mono text-[11px] text-charcoal-700/50">{product.id}</span>
      </div>

      <h3 class="text-base font-bold text-charcoal-900 group-hover:text-lavender-700 transition-colors">
        <a href={`/products/${product.slug}`} class="focus-visible:outline-none focus-visible:underline">
          {product.name}
        </a>
      </h3>

      <p class="text-xs text-charcoal-700 line-clamp-2 leading-relaxed">
        {product.shortDescription}
      </p>
    </div>

    <!-- Pricing & Preorder Action Area -->
    <div class="pt-3 border-t border-charcoal-800/10 space-y-3">
      <div class="flex items-center justify-between text-xs">
        <span class="text-charcoal-700 font-medium">Pricing:</span>
        <span class="text-charcoal-800 italic">Confirmed on WhatsApp</span>
      </div>

      <WhatsAppPreorderButton
        client:idle
        product={product}
        ctaPlacement={ctaPlacement}
        showFallbackCopy={false}
        className="py-2.5 text-xs"
      />
    </div>
  </div>
</article>
