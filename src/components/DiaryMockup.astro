---
interface Props { src: string; alt: string; imageId?: string; eager?: boolean; }
const {src,alt,imageId,eager=false}=Astro.props;
---
<div class="diary-stage">
  <div class="diary-object" data-diary-object>
    <div class="diary-paper" aria-hidden="true"></div>
    <img id={imageId} src={src} alt={alt} width="600" height="600" loading={eager?'eager':'lazy'} decoding="async" />
    <div class="diary-binding" aria-hidden="true">{Array.from({length:12},()=> <span></span>)}</div>
  </div>
</div>
