---
import { SITE } from '../config/site';
---

<div class="bg-charcoal-800 text-ivory-100 text-xs py-2 px-4 text-center font-medium tracking-wide">
  <div class="max-w-7xl mx-auto flex items-center justify-center gap-2">
    <span class="w-1.5 h-1.5 rounded-full bg-peach-400 animate-pulse" aria-hidden="true"></span>
    <p>
      <span>{SITE.announcementText}</span>
      <a
        href={SITE.whatsappBaseUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="underline underline-offset-4 ml-1.5 hover:text-lavender-300 transition-colors"
      >
        Chat on WhatsApp &rarr;
      </a>
    </p>
  </div>
</div>
