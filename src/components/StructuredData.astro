---
import { SITE } from '../config/site';
import type { Product } from '../types/product';
import type { JournalArticle } from '../types/journal';

interface Props {
  type: 'website' | 'product' | 'article' | 'breadcrumbs' | 'faq';
  product?: Product;
  article?: JournalArticle;
  breadcrumbs?: Array<{ name: string; item: string }>;
  faqs?: Array<{ question: string; answer: string }>;
}

const { type, product, article, breadcrumbs, faqs } = Astro.props;

let schema: Record<string, any> = {};

if (type === 'website') {
  schema = {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'Organization',
        '@id': `${SITE.canonicalUrl}/#organization`,
        name: SITE.name,
        url: SITE.canonicalUrl,
        logo: `${SITE.canonicalUrl}/brand/logo-horizontal.svg`,
        description: SITE.description,
        contactPoint: {
          '@type': 'ContactPoint',
          contactType: 'Customer Service WhatsApp',
          telephone: SITE.whatsappDisplayNumber,
          url: SITE.whatsappBaseUrl,
          areaServed: 'IN',
          availableLanguage: ['en', 'hi'],
        },
      },
      {
        '@type': 'WebSite',
        '@id': `${SITE.canonicalUrl}/#website`,
        url: SITE.canonicalUrl,
        name: SITE.name,
        description: SITE.tagline,
        publisher: { '@id': `${SITE.canonicalUrl}/#organization` },
        inLanguage: 'en-IN',
      },
    ],
  };
} else if (type === 'product' && product) {
  schema = {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.name,
    description: product.shortDescription,
    image: product.images.map((img) => `${SITE.canonicalUrl}${img.src}`),
    sku: product.id,
    brand: {
      '@type': 'Brand',
      name: SITE.name,
    },
    category: product.collectionName,
    // Note: Price is omitted or marked SoldOut/PreOrder according to launch rules.
    // "If price is unknown, omit fabricated offers... Do not mark products in stock"
    offers: {
      '@type': 'Offer',
      priceCurrency: 'INR',
      availability: 'https://schema.org/SoldOut',
      url: `${SITE.canonicalUrl}/products/${product.slug}`,
      itemCondition: 'https://schema.org/NewCondition',
    },
  };
} else if (type === 'article' && article) {
  schema = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: article.title,
    description: article.excerpt,
    image: `${SITE.canonicalUrl}${article.featuredImage.src}`,
    datePublished: article.publishedDate,
    dateModified: article.updatedDate,
    author: {
      '@type': 'Organization',
      name: article.author.name,
      url: SITE.canonicalUrl,
    },
    publisher: {
      '@type': 'Organization',
      name: SITE.name,
      logo: {
        '@type': 'ImageObject',
        url: `${SITE.canonicalUrl}/brand/logo-horizontal.svg`,
      },
    },
    mainEntityOfPage: `${SITE.canonicalUrl}/journal/${article.slug}`,
  };
} else if (type === 'breadcrumbs' && breadcrumbs) {
  schema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, idx) => ({
      '@type': 'ListItem',
      position: idx + 1,
      name: crumb.name,
      item: crumb.item.startsWith('http') ? crumb.item : `${SITE.canonicalUrl}${crumb.item}`,
    })),
  };
} else if (type === 'faq' && faqs) {
  schema = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: f.answer,
      },
    })),
  };
}
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
