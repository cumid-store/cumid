---
import { SITE } from '../config/site';
import MobileNavDrawer from './islands/MobileNavDrawer';
import HeaderAuthButton from './islands/HeaderAuthButton';

/* Only mobileInline is needed — the drawer filters itself internally */
const INLINE_LABELS = new Set(['Shop', 'Collections', 'Our Story']);
const mobileInline  = SITE.navLinks.filter(l => INLINE_LABELS.has(l.label));
---

<header class="sticky top-0 z-30 bg-ivory-200 border-b border-charcoal-800/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20 gap-2">

      <!-- Brand Logo Lockup -->
      <a href="/" class="flex-none flex items-center gap-3 group focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lavender-600 rounded-lg p-1" aria-label="CUMID Home">
        <img
          src="/brand/logo-horizontal.svg"
          alt="CUMID Pocket Diaries"
          class="h-12 sm:h-14 w-16 transition-transform group-hover:scale-[1.02]"
          width="64"
          height="56"
        />
      </a>

      <!-- Desktop Navigation (md+) -->
      <nav class="hidden md:flex items-center space-x-7" aria-label="Main Navigation">
        {SITE.navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-charcoal-800 hover:text-lavender-700 transition-colors py-1 relative after:absolute after:bottom-0 after:left-0 after:w-0 after:h-0.5 after:bg-lavender-600 hover:after:w-full after:transition-all"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Mobile centre nav: Shop · Collections · Our Story (in the header bar) -->
      <nav
        class="md:hidden flex items-center gap-1.5 overflow-x-auto flex-1 justify-center"
        aria-label="Mobile Quick Navigation"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {mobileInline.map((link) => (
          <a
            href={link.href}
            class="flex-none px-3 py-1.5 rounded-full text-xs font-semibold text-charcoal-800 hover:bg-lavender-100 hover:text-lavender-700 active:bg-lavender-200 transition-colors whitespace-nowrap border border-charcoal-800/15"
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Right Header Actions -->
      <div class="flex-none flex items-center space-x-2 sm:space-x-4">

        <!-- Favourites (hidden on smaller screens < md, accessible inside hamburger menu) -->
        <a
          href="/account/favourites"
          class="hidden md:inline-flex p-2.5 rounded-full text-charcoal-800 hover:bg-ivory-300 transition-colors relative focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-lavender-600"
          aria-label="View Saved Favourites"
          title="Saved Favourites"
        >
          <svg class="w-5 h-5 text-charcoal-800" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
          </svg>
        </a>

        <!-- Dynamic Account / Sign-in Island (shows LogIn icon when logged out, User icon when logged in) -->
        <HeaderAuthButton client:load />

        <!-- WhatsApp button (desktop only) -->
        <a
          href={SITE.whatsappBaseUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hidden lg:inline-flex items-center gap-2 px-4 py-2 rounded-sm text-xs font-medium bg-ivory-200 hover:bg-ivory-400 text-charcoal-800 border border-charcoal-800/15 transition-all"
        >
          <span>WhatsApp Preorders</span>
        </a>

        <!-- Mobile drawer with Saved Favourites & Account -->
        <MobileNavDrawer client:load />
      </div>

    </div>
  </div>
</header>
