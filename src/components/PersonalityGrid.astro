---
import { COLLECTION_LIST } from '../data/collections';
---

<section class="py-16 sm:py-24 bg-ivory-200" id="personalities">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto space-y-3 mb-12">
      <span class="text-xs font-semibold tracking-wider uppercase text-lavender-700">
        Curated Themes
      </span>
      <h2 class="text-3xl sm:text-4xl font-semibold text-charcoal-900">
        Choose your personality
      </h2>
      <p class="text-sm sm:text-base text-charcoal-700">
        Whether your brain operates on caffeine and sarcasm, or finds calm in botanical twilights, there is a cover built for your thoughts.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {COLLECTION_LIST.map((col) => (
        <a
          href={`/collections/${col.slug}`}
          class="group p-6 rounded-sm border border-charcoal-800/10   transition-all duration-300 flex flex-col justify-between"
          style={`background-color: ${col.accentBg};`}
        >
          <div class="space-y-4">
            <span
              class="inline-block text-[11px] font-semibold px-2.5 py-1 rounded-full uppercase tracking-wider"
              style={`color: ${col.themeColor}; background-color: rgba(255,255,255,0.7);`}
            >
              {col.personalityPill}
            </span>

            <h3 class="text-2xl font-bold text-charcoal-900 group-hover:text-lavender-700 transition-colors">
              {col.name}
            </h3>

            <p class="text-xs text-charcoal-700 leading-relaxed">
              {col.description}
            </p>
          </div>

          <div class="pt-6 flex items-center justify-between text-xs font-semibold text-charcoal-800 group-hover:translate-x-1 transition-transform">
            <span>Explore collection</span>
            <span>&rarr;</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
