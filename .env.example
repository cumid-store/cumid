# CUMID Store — Environment Configuration Template
# Copy to .env for local development. Never commit secret keys or production service credentials.

# Canonical Domain & Public URL
PUBLIC_SITE_URL=https://cumid.store

# Supabase (Optional Client Authentication & Favourites)
# If left empty, site functions 100% in guest mode with local favorites and WhatsApp enquiries.
PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your-public-anon-key

# Optional Marketing Analytics (Google Analytics 4)
# G-XXXXXXXXXX will only be loaded after affirmative visitor consent.
PUBLIC_GA4_MEASUREMENT_ID=

# Cloudflare Web Analytics Token (Cookieless aggregate analytics)
PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN=
